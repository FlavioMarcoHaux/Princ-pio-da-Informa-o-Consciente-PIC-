        self.L = 1.0e-3
        self.A = 1.0e-4
        self.T_quente = 310.0
        self.T_frio = 295.0
        self.T_medio = (self.T_quente + self.T_frio) / 2
        self.Delta_T = self.T_quente - self.T_frio
    
    def calcular(self, grad_phi_S):
        delta_ZT = self.params['chi'] * (grad_phi_S ** 2)
        ZT_ef = self.ZT_base + delta_ZT
        eta_TE = (np.sqrt(1 + ZT_ef) - 1) / (np.sqrt(1 + ZT_ef) + 1)
        R = self.L / (self.sigma_cond * self.A)
        V_oc = self.Seebeck * self.Delta_T
        P_util = (V_oc ** 2) / (4 * R) * eta_TE
        return {
            'ZT_ef': ZT_ef, 'delta_ZT': delta_ZT,
            'eta_TE': eta_TE, 'P_util_W': P_util,
            'V_oc_mV': V_oc * 1e3, 'R_ohm': R,
            'grad_phi_S': grad_phi_S
        }
```

APÊNDICE C: CÓDIGO PYTHON — SENSOR O_info

```python
class SensorOinfo:
    def __init__(self, params):
        self.params = params
        self.lambda_laser = 1550e-9
        self.n_eff = 2.0
        self.L_arm = 1.0e-3
        self.P_in = 1.0e-3
    
    def visibilidade_para_Oinfo(self, V, V_max=1.0, O_min=-1.0, O_max=0.5):
        beta = 2.0
        ratio = V / V_max
        return O_min * (ratio ** beta) + O_max * (1 - ratio ** beta)
    
    def calcular_visibilidade(self, delta_phi, coerencia_temporal=1.0):
        return np.abs(np.cos(delta_phi / 2)) * coerencia_temporal
    
    def potencia_saida(self, delta_phi, coerencia_temporal=1.0):
        V = self.calcular_visibilidade(delta_phi, coerencia_temporal)
        P_out1 = 0.5 * self.P_in * (1 + V * np.cos(delta_phi))
        P_out2 = 0.5 * self.P_in * (1 - V * np.cos(delta_phi))
        return P_out1, P_out2, V
