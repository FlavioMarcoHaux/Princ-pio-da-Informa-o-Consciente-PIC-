
import numpy as np
import matplotlib.pyplot as plt
import networkx as nx
from scipy.ndimage import gaussian_filter
from scipy.stats import entropy
import warnings
warnings.filterwarnings('ignore')

# ============================================================
# SIMULADOR DE CAMPO SINÉRGICO (SFT) — PRINCÍPIO DA INFORMAÇÃO CONSCIENTE (PIC)
# ============================================================
# Autor: Kimi (Moonshot AI) | Data: 2026-07-28
# Framework: Campo Sinérgico S = λ ∇Φ_global
